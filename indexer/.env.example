# Indexer environment — copy this file to .env before running `npm start`
#
#   cp indexer/.env.example indexer/.env
#
# Full variable reference is in the root .env.example

# ── Stellar Network ────────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Matches the postgres service credentials in docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soroban_explorer

# ── Indexer ────────────────────────────────────────────────────────────────────
PORT=3001
START_LEDGER=0
POLL_MS=5000
EXPLORER_CONTRACT_ID=CDA2ZCIB3ETZNFNQP4NS3SIEW5XCF7DKP5UWN4Y33F5FV34JA2CGAJ44

# ── DEX / Lending Protocol Integrations (leave blank to disable decoding) ─────
STELLARSWAP_CONTRACT_ID=
BLEND_CONTRACT_ID=

# ── Auth / Rate limiting (leave blank to disable) ─────────────────────────────
ADMIN_SECRET=
# Optional TOTP second factor for /api/admin/* (base32). Leave blank to disable.
# ADMIN_TOTP_SECRET=
REDIS_URL=

# ── Observability ──────────────────────────────────────────────────────────────
# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# ── Email Configuration (for self-service API key creation) ───────────────────
# Choose one: Resend (recommended) or SMTP
# Resend configuration (https://resend.com)
RESEND_API_KEY=

# SMTP configuration (alternative to Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@soroban-explorer.com

# Base URL for verification links (e.g., https://api.example.com)
API_BASE_URL=

# ── Signed API responses (#904) ─────────────────────────────────────────────
# Inject from KMS / Vault at deploy time; never commit or write to disk.
# base64 32-byte Ed25519 seed. Unset = ?signed=1 returns 501.
# EXPLORER_SIGNING_KEY=
# EXPLORER_SIGNING_KEY_ID=
# EXPLORER_SIGNING_KEY_NOT_BEFORE=
# Retired public keys kept published during rotation, JSON array:
# [{"key_id":"...","public_key":"<base64>","not_before":"...","not_after":"..."}]
# EXPLORER_RETIRED_SIGNING_KEYS=

# ── Secrets provider + envelope encryption (#929) ────────────────────────────
# env (default, dev only) | vault
# SECRETS_PROVIDER=env
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=
# VAULT_SECRET_PATH=secret/data/soroban-indexer
# Key-encryption key for DB-stored secrets: base64 of 32 random bytes
#   (openssl rand -base64 32). Unset = stored unencrypted (local dev only).
# SECRETS_KEK=
# Comma-separated previous KEKs, kept until rotation completes.
# SECRETS_KEK_PREVIOUS=

# ── Abuse scoring (#931) ─────────────────────────────────────────────────────
# Shadow mode (score + log only) unless set to true.
# ABUSE_ENFORCE=false
# Comma-separated API-key ids / IPs that are never scored.
# ABUSE_ALLOWLIST=

# ── Admin Security & Access Control (#982) ──────────────────────────────────
# Comma-separated IPv4/IPv6 addresses allowed to access /api/admin/* endpoints.
# Unset allows requests from any IP provided ADMIN_SECRET is valid.
# ADMIN_IP_ALLOWLIST=

# Bearer token or API key required to access /metrics endpoint. Unset = public metrics.
# METRICS_API_KEY=

# DANGEROUS: Set to true to completely bypass API rate limiting. NEVER set to true in production!
# RATE_LIMITING_DISABLED=false

# Grace period in minutes for retired signing keys during key rotation (default: 60).
# KEY_ROTATION_GRACE_MINUTES=60

# External URL of the admin panel or webhook callback base URL.
# ADMIN_URL=

# ── Indexer Operations & Telemetry (#982) ───────────────────────────────────
# Maximum tolerable lag in seconds between current ledger and indexed ledger (default: 60).
# INDEXER_LAG_THRESHOLD_SECONDS=60

# Unique instance identifier for this indexer node in clustered deployments (default: indexer-1).
# INSTANCE_ID=indexer-1

# Comma-separated list of Kafka broker hosts (e.g., localhost:9092) for event streaming.
# KAFKA_BROKERS=

# Redis key used for distributed leader election lock (default: indexer:leader).
# LEADER_ELECTION_KEY=indexer:leader

# Log level verbosity: debug | info | warn | error (default: info).
# LOG_LEVEL=info

# Target network name: testnet | mainnet | futurenet (default: testnet).
# NETWORK=testnet

# OpenTelemetry OTLP collector gRPC/HTTP endpoint (e.g., http://localhost:4317).
# OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenTelemetry service name for distributed tracing (default: soroban-indexer).
# OTEL_SERVICE_NAME=soroban-indexer

# Enable distributed OpenTelemetry tracing: true | false (default: false).
# OTEL_TRACING_ENABLED=false

# PagerDuty Events API v2 integration / routing key for alerting on critical indexer failures.
# PAGERDUTY_ROUTING_KEY=

# Batch size for historical contract re-decoding worker passes (default: 100).
# REDECODE_BATCH_SIZE=100

# Polling interval in milliseconds between re-decoding worker batches (default: 5000).
# REDECODE_INTERVAL_MS=5000

# Incoming Slack webhook URL for real-time operational alerts and notifications.
# SLACK_WEBHOOK_URL=

# Automatically verify and register ABI schemas on upload: true | false (default: true).
# VERIFY_ABI=true

# Batch size for processing pending contract ABI verification queue (default: 10).
# VERIFY_BATCH_SIZE=10

# Cron expression for background contract ABI verification job (default: */5 * * * *).
# VERIFY_CRON=*/5 * * * *

# ── Deployable role (#935) ─────────────────────────────────────────────────────
# all | ingest | api | workers. Helm sets this per Deployment.
INDEXER_ROLE=all
# Redis-lease leader election for ingest pods (requires REDIS_URL).
LEADER_ELECTION_ENABLED=false
# Keep serving this long after SIGTERM while readiness reports draining.
SHUTDOWN_DRAIN_MS=10000

# ── Registry moderation (#934) ─────────────────────────────────────────────────
# Queue hide/reject/ban actions for mirroring via the contract's Moderator role.
MODERATION_ONCHAIN_MIRROR=false

# ── Developer accounts / passkeys (#933) ───────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Soroban Explorer
WEBAUTHN_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
SESSION_STEP_UP_MINUTES=5
# Dev/test only: return email-link tokens in API responses (ignored in production).
AUTH_EMAIL_ECHO_TOKEN=false
# Optional SEP-10 "Sign in with Stellar" (server signing key + home domain).
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost
